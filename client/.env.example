# API origin (no trailing slash). Used by:
# - Vite dev proxy → forwards /api to this host (vite.config.js)
# - fetch base in src/services/dogsApi.js when set (production / cross-origin dev)
VITE_API_URL=http://localhost:3001

# Local dev server port for `npm run dev` (vite.config.js only; not bundled into the app)
CLIENT_PORT=5173
